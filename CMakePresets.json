{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VSS_BUILD_TESTS": "ON",
        "VSS_BUILD_TOOLS": "ON",
        "VSS_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_POLICY_DEFAULT_CMP0141": "NEW",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-debug-gui",
      "displayName": "Linux, Debug, with the GUI (fails without Qt)",
      "inherits": "linux-debug",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux, Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VSS_BUILD_PERF": "ON"
      }
    },
    {
      "name": "linux-release-gui",
      "displayName": "Linux, Release, with the GUI (fails without Qt)",
      "inherits": "linux-release",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS, Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-debug-gui",
      "displayName": "macOS, Debug, with the GUI (fails without Qt)",
      "inherits": "macos-debug",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS, Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VSS_BUILD_PERF": "ON"
      }
    },
    {
      "name": "macos-release-gui",
      "displayName": "macOS, Release, with the GUI (fails without Qt)",
      "inherits": "macos-release",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows, MSVC, Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-debug-gui",
      "displayName": "Windows, MSVC, Debug, with the GUI (fails without Qt)",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows, MSVC, Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VSS_BUILD_PERF": "ON"
      }
    },
    {
      "name": "windows-msvc-release-gui",
      "displayName": "Windows, MSVC, Release, with the GUI (fails without Qt)",
      "inherits": "windows-msvc-release",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux, coverage (Clang, LLVM profile instrumentation)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VSS_COVERAGE": "ON",
        "VSS_TRACY": "OFF",
        "VSS_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "macos-coverage",
      "displayName": "macOS, coverage (Clang, LLVM profile instrumentation)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VSS_COVERAGE": "ON",
        "VSS_TRACY": "OFF",
        "VSS_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux, AddressSanitizer and UBSan, -O1",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ICL_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux, ThreadSanitizer, -O1",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ICL_SANITIZERS": "thread"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows, MSVC, AddressSanitizer, /O1",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ICL_SANITIZERS": "address"
      }
    },
    {
      "name": "windows-msvc-analysis",
      "displayName": "Windows, MSVC, Debug, with the GUI, PREfast code analysis (/analyze)",
      "description": "Compiles every first-party file with /analyze and the NativeRecommendedRules rule set and leaves one .sarif file per object file. Analysis warnings do not stop the build. Run through tools/analyze.py msvc.",
      "inherits": "windows-msvc-debug-gui",
      "environment": {
        "CXXFLAGS": "/analyze /analyze:WX- /analyze:external- /analyze:ruleset \"$env{VSINSTALLDIR}Team Tools\\Static Analysis Tools\\Rule Sets\\NativeRecommendedRules.ruleset\" /analyze:log:format:sarif /analyze:autolog"
      }
    },
    {
      "name": "linux-asan-ubsan-gui",
      "displayName": "Linux, AddressSanitizer and UBSan, -O1, with the GUI (fails without Qt)",
      "inherits": "linux-asan-ubsan",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "linux-tsan-gui",
      "displayName": "Linux, ThreadSanitizer, -O1, with the GUI (fails without Qt)",
      "inherits": "linux-tsan",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "windows-msvc-asan-gui",
      "displayName": "Windows, MSVC, AddressSanitizer, /O1, with the GUI (fails without Qt)",
      "inherits": "windows-msvc-asan",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux, libFuzzer with AddressSanitizer and UBSan, -O1 (Clang)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ICL_ENABLE_FUZZING": "ON",
        "VSS_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "windows-llvm-coverage",
      "displayName": "Windows, coverage (clang-cl, LLVM profile instrumentation)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VSS_COVERAGE": "ON",
        "VSS_TRACY": "OFF",
        "VSS_BUILD_GUI": "OFF",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-coverage-gui",
      "displayName": "Linux, coverage with the GUI (Clang, fails without Qt)",
      "inherits": "linux-coverage",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON"
      }
    },
    {
      "name": "windows-llvm-coverage-gui",
      "displayName": "Windows, coverage with the GUI (clang-cl, fails without Qt)",
      "inherits": "windows-llvm-coverage",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON",
        "CMAKE_C_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-tracy",
      "displayName": "Linux, profiling (Release with Tracy; needs VCPKG_ROOT)",
      "inherits": "linux-base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VSS_TRACY": "ON",
        "VSS_BUILD_PERF": "ON",
        "VSS_BUILD_GUI": "OFF",
        "VSS_BUILD_TESTS": "OFF",
        "VSS_BUILD_TOOLS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-tracy-gui",
      "displayName": "Linux, profiling with the GUI (Release with Tracy; needs VCPKG_ROOT and Qt)",
      "inherits": "linux-tracy",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON",
        "VSS_BUILD_TESTS": "ON",
        "VSS_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "windows-msvc-tracy",
      "displayName": "Windows, MSVC, profiling (Release with Tracy; needs VCPKG_ROOT)",
      "inherits": "windows-base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VSS_TRACY": "ON",
        "VSS_BUILD_PERF": "ON",
        "VSS_BUILD_GUI": "OFF",
        "VSS_BUILD_TESTS": "OFF",
        "VSS_BUILD_TOOLS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-tracy-gui",
      "displayName": "Windows, MSVC, profiling with the GUI (Release with Tracy; needs VCPKG_ROOT and Qt)",
      "inherits": "windows-msvc-tracy",
      "cacheVariables": {
        "VSS_BUILD_GUI": "ON",
        "VSS_GUI_REQUIRED": "ON",
        "VSS_BUILD_TESTS": "ON",
        "VSS_BUILD_TOOLS": "ON"
      }
    }
