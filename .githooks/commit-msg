# Derived from the Boost.VirtualSerial repository hook.
#
# Rejects commit messages that carry attribution trailers, "generated by/with"
# statements, robot markers or tool attribution.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypass is deliberately not documented; the CI job checks the same rules.

set -eu

root=$(git rev-parse --show-toplevel)
checker="$root/tools/check_commit_message.py"

# Windows exposes a Microsoft Store "python" stub that exists on PATH but
# fails when executed, so every candidate is proved to work before it is used.
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys' >/dev/null 2>&1; then
        exec "$candidate" "$checker" "$1"
    fi
done

echo "commit-msg: no working python interpreter found" >&2
exit 1
