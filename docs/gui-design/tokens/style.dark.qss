/* Virtual Serial Studio: Qt style sheet template.
 * Percent-wrapped names (for example the accent colour) are replaced from tokens/tokens.json for the active theme (light or dark).
 * Render at runtime in Theme::styleSheet(); tools/gen_qss.py renders both themes for review.
 *
 * QSS LIMITS you must design around:
 *  - No box-shadow, no outline, no CSS variables, no flex or grid. Layout lives in C++ layouts.
 *  - QSS cannot tell keyboard focus from mouse focus. The 2px focus ring is painted by a QProxyStyle
 *    (PE_FrameFocusRect), see docs/02-design-tokens.md.
 *  - Do not set font-family or font-size here. Fonts come from the platform and are scaled in C++.
 *  - Status chips, switches, steppers and the topology are custom painted widgets, not QSS.
 *  - Select by dynamic property, e.g. QPushButton[role="primary"]. After changing a property call
 *    style()->unpolish(w); style()->polish(w);
 */

QMainWindow, QDialog { background: #11161D; color: #E8EDF3; }
QDialog[surface="panel"] { background: #1A212B; }
QWidget:disabled { color: #6A7686; }
QToolTip { background: #18212D; color: #F2F4F7; border: 0; padding: 5px 9px; }
QLabel[muted="true"] { color: #9EABBB; }

/* menu and toolbar */
QMenuBar { background: #1A212B; border-bottom: 1px solid #2B3543; }
QMenuBar::item { padding: 4px 10px; border-radius: 3px; background: transparent; }
QMenuBar::item:selected { background: #163640; color: #86CDE2; }
QMenu { background: #1A212B; border: 1px solid #445064; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 3px; }
QMenu::item:selected { background: #163640; color: #E8EDF3; }
QMenu::item:disabled { color: #6A7686; }
QMenu::separator { height: 1px; background: #2B3543; margin: 4px 8px; }
QToolBar { background: #1A212B; border: 0; border-bottom: 1px solid #2B3543; spacing: 4px; padding: 0 12px; }
QToolButton { min-height: 34px; padding: 0 10px; border: 1px solid transparent; border-radius: 4px; background: transparent; color: #E8EDF3; }
QToolButton:hover { background: #151B23; }
QToolButton:checked { background: #163640; border-color: #2F6171; color: #86CDE2; }
QToolButton:disabled { color: #6A7686; }
QStatusBar { background: #1A212B; border-top: 1px solid #2B3543; color: #B8C3D1; }
QStatusBar::item { border: 0; }

/* buttons */
QPushButton { min-height: 34px; padding: 0 16px; border: 1px solid #7E8A9C; border-radius: 4px; background: #1A212B; color: #E8EDF3; font-weight: 500; }
QPushButton:hover { background: #151B23; }
QPushButton:pressed { background: #163640; }
QPushButton:disabled { color: #6A7686; border-color: #2B3543; background: #151B23; }
QPushButton[role="primary"] { background: #59B9D4; border-color: #86CDE2; color: #06222B; }
QPushButton[role="primary"]:hover { background: #86CDE2; }
QPushButton[role="primary"]:disabled { background: #151B23; border-color: #2B3543; color: #6A7686; }
QPushButton[role="quiet"] { background: transparent; border-color: transparent; color: #86CDE2; }
QPushButton[role="quiet"]:hover { background: #151B23; }
QPushButton[role="danger"] { background: #FF8D86; border-color: #FFB4AE; color: #3C0A07; }
QPushButton[size="small"] { min-height: 28px; padding: 0 10px; }
QPushButton[size="icon"] { min-height: 24px; min-width: 24px; padding: 0; }

/* fields */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit { min-height: 32px; padding: 0 10px; border: 1px solid #7E8A9C; border-radius: 4px; background: #1A212B; color: #E8EDF3; selection-background-color: #59B9D4; selection-color: #06222B; }
QPlainTextEdit, QTextEdit { padding: 6px 10px; }
QLineEdit:read-only { background: #151B23; }
QLineEdit[invalid="true"], QComboBox[invalid="true"], QSpinBox[invalid="true"] { border: 2px solid #FF8D86; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #151B23; border-color: #2B3543; color: #6A7686; }
QCheckBox, QRadioButton { spacing: 8px; min-height: 24px; }
QSlider::groove:horizontal { height: 4px; background: #445064; border-radius: 2px; }
QSlider::handle:horizontal { width: 18px; height: 18px; margin: -7px 0; border-radius: 9px; background: #59B9D4; border: 1px solid #86CDE2; }
QProgressBar { min-height: 8px; max-height: 8px; border: 0; border-radius: 4px; background: #2B3543; text-align: center; }
QProgressBar::chunk { background: #59B9D4; border-radius: 4px; }

/* item views */
QTableView, QTreeView, QListView { background: #1A212B; alternate-background-color: #151B23; gridline-color: #2B3543; border: 0; selection-background-color: #163640; selection-color: #E8EDF3; outline: 0; }
QHeaderView::section { background: #151B23; color: #B8C3D1; border: 0; border-bottom: 1px solid #2B3543; padding: 0 10px; min-height: 28px; font-weight: 600; }
QScrollBar:vertical { width: 12px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 12px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #445064; min-height: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:horizontal { background: #445064; min-width: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

/* tabs and docks */
QTabWidget::pane { border: 0; }
QTabBar { background: #151B23; }
QTabBar::tab { padding: 0 14px; min-height: 32px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #B8C3D1; }
QTabBar::tab:selected { border-bottom: 2px solid #59B9D4; color: #E8EDF3; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #1A212B; }
QDockWidget::title { background: #151B23; padding: 6px 12px; border-bottom: 1px solid #2B3543; font-weight: 600; text-align: left; }
QSplitter::handle { background: transparent; }

/* cards, notes, code, toast: QFrame with dynamic properties */
QFrame[card="true"] { background: #1A212B; border: 1px solid #2B3543; border-radius: 8px; }
QFrame[pick="true"] { background: #1A212B; border: 1px solid #7E8A9C; border-radius: 8px; }
QFrame[pick="true"][selected="true"] { background: #163640; border: 1px solid #59B9D4; }
QFrame[note="info"] { background: #163640; border: 1px solid #2F6171; border-radius: 6px; }
QFrame[note="info"] QLabel { color: #BDE6F1; }
QFrame[note="ok"] { background: #12301F; border: 1px solid #2C6446; border-radius: 6px; }
QFrame[note="ok"] QLabel { color: #BFEBD3; }
QFrame[note="warn"] { background: #3A2A10; border: 1px solid #6E4E1C; border-radius: 6px; }
QFrame[note="warn"] QLabel { color: #FFE2B8; }
QFrame[note="danger"] { background: #3C1815; border: 1px solid #7E3029; border-radius: 6px; }
QFrame[note="danger"] QLabel { color: #FFD2CE; }
QFrame[code="true"] { background: #151B23; border: 1px solid #2B3543; border-radius: 4px; }
QFrame#Toast { background: #18212D; border: 0; border-radius: 6px; }
QFrame#Toast QLabel { color: #F2F4F7; }
